{
  "name": "kova-desktop",
  "version": "0.1.5",
  "description": "Kova desktop shell (PoC): thin Electron wrapper around the web app with native notifications, tray and auto-launch.",
  "private": true,
  "author": {
    "name": "We Are Materia",
    "email": "web@cleiva.dev"
  },
  "allowScripts": {
    "electron@37.10.3": true,
    "electron-winstaller@5.4.0": true
  },
  "main": "main.cjs",
  "scripts": {
    "start": "electron .",
    "start:system": "ELECTRON_OVERRIDE_DIST_PATH=/usr/lib/electron electron .",
    "dist:mac": "electron-builder --mac",
    "dist:win": "electron-builder --win",
    "dist:linux": "electron-builder --linux"
  },
  "devDependencies": {
    "electron": "^37.0.0",
    "electron-builder": "^26.0.0"
  },
  "build": {
    "appId": "com.wearemateria.kova",
    "productName": "Kova",
    "files": [
      "main.cjs",
      "preload.cjs"
    ],
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.productivity",
      "extendInfo": {
        "NSCameraUsageDescription": "Kova uses your camera for video calls.",
        "NSMicrophoneUsageDescription": "Kova uses your microphone for video calls."
      }
    },
    "win": {
      "target": [
        "nsis"
      ]
    },
    "linux": {
      "target": [
        "AppImage",
        "pacman"
      ],
      "category": "Office"
    },
    "pacman": {
      "depends": [
        "c-ares",
        "ffmpeg",
        "gtk3",
        "libevent",
        "libvpx",
        "libxslt",
        "libxss",
        "minizip",
        "nss",
        "re2",
        "snappy",
        "libnotify",
        "libappindicator-gtk3"
      ]
    }
  }
}
