{
  "name": "kova-desktop",
  "version": "0.1.1",
  "description": "Kova desktop shell (PoC): thin Electron wrapper around the web app with native notifications, tray and auto-launch.",
  "private": true,
  "allowScripts": {
    "electron": true,
    "electron-winstaller": true
  },
  "main": "main.cjs",
  "scripts": {
    "start": "electron .",
    "start:system": "ELECTRON_OVERRIDE_DIST_PATH=/usr/lib/electron electron .",
    "dist:mac": "electron-builder --mac",
    "dist:win": "electron-builder --win",
    "dist:linux": "electron-builder --linux"
  },
  "devDependencies": {
    "electron": "^37.0.0",
    "electron-builder": "^26.0.0"
  },
  "build": {
    "appId": "com.wearemateria.kova",
    "productName": "Kova",
    "files": [
      "main.cjs",
      "preload.cjs"
    ],
    "mac": {
      "target": ["dmg"],
      "category": "public.app-category.productivity"
    },
    "win": {
      "target": ["nsis"]
    },
    "linux": {
      "target": ["AppImage"],
      "category": "Office"
    }
  }
}